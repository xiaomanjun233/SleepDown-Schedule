<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_today_background">

    <ImageView
        android:id="@+id/widget_week_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_today_background"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_week_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="9dp">

        <LinearLayout
            android:id="@+id/widget_week_header"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_launcher_preview" />

            <TextView
                android:id="@+id/widget_week_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:textColor="#FF111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_week_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:textColor="#99111111"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="5dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/widget_week_day_header"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/widget_week_period_header_spacer"
                    android:layout_width="22dp"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/widget_week_day_name_1"
                    style="@style/WidgetWeekScrollableDay"
                    android:text="周一" />
                <TextView
                    android:id="@+id/widget_week_day_name_2"
                    style="@style/WidgetWeekScrollableDay"
                    android:text="周二" />
                <TextView
                    android:id="@+id/widget_week_day_name_3"
                    style="@style/WidgetWeekScrollableDay"
                    android:text="周三" />
                <TextView
                    android:id="@+id/widget_week_day_name_4"
                    style="@style/WidgetWeekScrollableDay"
                    android:text="周四" />
                <TextView
                    android:id="@+id/widget_week_day_name_5"
                    style="@style/WidgetWeekScrollableDay"
                    android:text="周五" />
                <TextView
                    android:id="@+id/widget_week_day_name_6"
                    style="@style/WidgetWeekScrollableDay"
                    android:text="周六" />
                <TextView
                    android:id="@+id/widget_week_day_name_7"
                    style="@style/WidgetWeekScrollableDay"
                    android:text="周日" />
            </LinearLayout>

            <ListView
                android:id="@+id/widget_week_period_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:cacheColorHint="@android:color/transparent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:fadingEdge="none"
                android:overScrollMode="never"
                android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
