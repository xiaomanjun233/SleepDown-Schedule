<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_today_background_compact">
    <ImageView android:id="@+id/widget_background_image" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_today_background_compact" android:clipToOutline="true" android:contentDescription="@null" android:scaleType="fitXY" android:visibility="gone" tools:targetApi="s" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="11dp">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:includeFontPadding="true" android:maxLines="1" android:textColor="#FF111111" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="true" android:textColor="#99000000" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#99000000" android:textSize="12sp" />
    <FrameLayout android:id="@+id/widget_compact_row_1" style="@style/WidgetCompactCourseRowFrame" android:layout_marginTop="4dp"><ImageView android:id="@+id/widget_compact_background_1" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:visibility="gone" /><LinearLayout android:id="@+id/widget_compact_content_1" style="@style/WidgetCompactCourseRowContent"><ImageView android:id="@+id/widget_compact_indicator_1" style="@style/WidgetCompactIndicator" android:contentDescription="@null" /><LinearLayout style="@style/WidgetCourseInfoColumn"><TextView android:id="@+id/widget_compact_name_1" style="@style/WidgetCompactCourseName" /><TextView android:id="@+id/widget_compact_detail_1" style="@style/WidgetCompactCourseDetail" /></LinearLayout></LinearLayout></FrameLayout>
    <FrameLayout android:id="@+id/widget_compact_row_2" style="@style/WidgetCompactCourseRowFrame" android:layout_marginTop="4dp"><ImageView android:id="@+id/widget_compact_background_2" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:visibility="gone" /><LinearLayout android:id="@+id/widget_compact_content_2" style="@style/WidgetCompactCourseRowContent"><ImageView android:id="@+id/widget_compact_indicator_2" style="@style/WidgetCompactIndicator" android:contentDescription="@null" /><LinearLayout style="@style/WidgetCourseInfoColumn"><TextView android:id="@+id/widget_compact_name_2" style="@style/WidgetCompactCourseName" /><TextView android:id="@+id/widget_compact_detail_2" style="@style/WidgetCompactCourseDetail" /></LinearLayout></LinearLayout></FrameLayout>
    <FrameLayout android:id="@+id/widget_compact_row_3" style="@style/WidgetCompactCourseRowFrame" android:layout_marginTop="4dp" android:visibility="gone"><ImageView android:id="@+id/widget_compact_background_3" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitXY" android:visibility="gone" /><LinearLayout android:id="@+id/widget_compact_content_3" style="@style/WidgetCompactCourseRowContent"><ImageView android:id="@+id/widget_compact_indicator_3" style="@style/WidgetCompactIndicator" android:contentDescription="@null" /><LinearLayout style="@style/WidgetCourseInfoColumn"><TextView android:id="@+id/widget_compact_name_3" style="@style/WidgetCompactCourseName" /><TextView android:id="@+id/widget_compact_detail_3" style="@style/WidgetCompactCourseDetail" /></LinearLayout></LinearLayout></FrameLayout>
</LinearLayout>
</FrameLayout>
