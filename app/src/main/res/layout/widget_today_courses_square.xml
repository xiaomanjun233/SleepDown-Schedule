<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_today_background_compact" android:orientation="vertical" android:padding="11dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:includeFontPadding="false" android:maxLines="1" android:textColor="#FF111111" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#99000000" android:textSize="11sp" />
        <ImageView android:id="@+id/widget_refresh" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginStart="4dp" android:background="@drawable/widget_refresh_background" android:contentDescription="@string/widget_refresh_description" android:padding="6dp" android:scaleType="centerInside" android:src="@drawable/ic_agent_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#99000000" android:textSize="12sp" />
    <LinearLayout android:id="@+id/widget_compact_row_1" style="@style/WidgetCompactCourseRow"><ImageView android:id="@+id/widget_compact_indicator_1" style="@style/WidgetCompactIndicator" /><LinearLayout style="@style/WidgetCourseInfoColumn"><TextView android:id="@+id/widget_compact_name_1" style="@style/WidgetCompactCourseName" /><TextView android:id="@+id/widget_compact_detail_1" style="@style/WidgetCompactCourseDetail" /></LinearLayout></LinearLayout>
    <LinearLayout android:id="@+id/widget_compact_row_2" style="@style/WidgetCompactCourseRow"><ImageView android:id="@+id/widget_compact_indicator_2" style="@style/WidgetCompactIndicator" /><LinearLayout style="@style/WidgetCourseInfoColumn"><TextView android:id="@+id/widget_compact_name_2" style="@style/WidgetCompactCourseName" /><TextView android:id="@+id/widget_compact_detail_2" style="@style/WidgetCompactCourseDetail" /></LinearLayout></LinearLayout>
    <LinearLayout android:id="@+id/widget_compact_row_3" style="@style/WidgetCompactCourseRow" android:visibility="gone"><ImageView android:id="@+id/widget_compact_indicator_3" style="@style/WidgetCompactIndicator" /><LinearLayout style="@style/WidgetCourseInfoColumn"><TextView android:id="@+id/widget_compact_name_3" style="@style/WidgetCompactCourseName" /><TextView android:id="@+id/widget_compact_detail_3" style="@style/WidgetCompactCourseDetail" /></LinearLayout></LinearLayout>
</LinearLayout>
