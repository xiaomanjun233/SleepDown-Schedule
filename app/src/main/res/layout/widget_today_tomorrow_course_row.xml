<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tt_course_root"
    android:layout_width="match_parent"
    android:layout_height="43dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_course_background_compact"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingTop="3dp"
    android:paddingEnd="7dp"
    android:paddingBottom="3dp">

    <ImageView
        android:id="@+id/widget_tt_course_indicator"
        android:layout_width="4dp"
        android:layout_height="24dp"
        android:layout_marginEnd="7dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_course_indicator" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_tt_course_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:textColor="#FF111111"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tt_course_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:textColor="#77111111"
            android:textSize="9.5sp" />
    </LinearLayout>
</LinearLayout>
