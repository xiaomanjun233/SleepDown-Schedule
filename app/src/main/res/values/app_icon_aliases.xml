<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Each fixed artwork is stored once per density; follow-mode aliases select the theme. -->
    <item type="mipmap" name="ic_launcher">@mipmap/ic_launcher_light</item>
    <item type="mipmap" name="ic_launcher_round">@mipmap/ic_launcher_light</item>
    <item type="mipmap" name="ic_launcher_kanban">@mipmap/ic_launcher_kanban_light</item>

    <!-- Keep SystemUI's drawable entry points fixed to the explicitly selected artwork. -->
    <item type="drawable" name="ic_live_update_minimal_light">@mipmap/ic_launcher_light</item>
    <item type="drawable" name="ic_live_update_minimal_dark">@mipmap/ic_launcher_dark</item>
    <item type="drawable" name="ic_live_update_kanban_light">@mipmap/ic_launcher_kanban_light</item>
    <item type="drawable" name="ic_live_update_kanban_dark">@mipmap/ic_launcher_kanban_dark</item>
</resources>
