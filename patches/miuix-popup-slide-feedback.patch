+                    onDrawWithContent {
+                        val rect = panel()
+                        clip.reset()
+                        clip.addRoundRect(RoundRect(
+                            Rect(rect.left - room, rect.top - room, rect.right - room, rect.bottom - room),
+                            rect.topLeftCornerRadius,
+                        ))
+                        clipPath(clip) { this@onDrawWithContent.drawContent() }
+                    }
+                }
+                .graphicsLayer {
+                    val rect = panel()
+                    val f = fractionProgress()
+                    val from = if (isEntering) 0.22f else 0.30f
+                    val to = if (isEntering) 0.62f else 0.78f
+                    alpha = ((f - from) / (to - from)).coerceIn(0f, 1f)
+                    scaleX = if (size.width > 0f) rect.width / size.width else 1f
+                    scaleY = scaleX
+                    translationX = (rect.left + rect.right - size.width) / 2f - room
+                    translationY = (rect.top + rect.bottom - size.height) / 2f - room
+                    val step = (6f * (1f - abs(2f * f - 1f)).coerceIn(0f, 1f)).roundToInt()
+                    renderEffect = if (step == 0) null else blurSteps[step] ?: run {
+                        val radius = step.dp.toPx()
