--- /dev/null
+++ b/miuix-ui/src/commonMain/kotlin/top/yukonga/miuix/kmp/basic/PopupSlideSelection.kt
@@ -0,0 +1,110 @@
+// Copyright 2026, compose-miuix-ui contributors
+// SPDX-License-Identifier: Apache-2.0
+package top.yukonga.miuix.kmp.basic
+
+import androidx.compose.foundation.ScrollState
+import androidx.compose.foundation.gestures.awaitEachGesture
+import androidx.compose.foundation.gestures.awaitFirstDown
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.hapticfeedback.HapticFeedback
+import androidx.compose.ui.hapticfeedback.HapticFeedbackType
+import androidx.compose.ui.input.pointer.PointerEventPass
+import androidx.compose.ui.input.pointer.changedToUpIgnoreConsumed
+import androidx.compose.ui.input.pointer.pointerInput
+import androidx.compose.ui.layout.LayoutCoordinates
+import androidx.compose.ui.layout.boundsInWindow
+import androidx.compose.ui.layout.onGloballyPositioned
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.flow.first
+
+internal val LocalPopupSlideSelection = staticCompositionLocalOf<PopupSlideSelection?> { null }
+
+internal class PopupSlideSelection {
+    class Item(var enabled: Boolean, var activate: () -> Unit) {
+        var coordinates: LayoutCoordinates? = null
+    }
+    val items = linkedMapOf<Any, Item>()
+    var highlighted by mutableStateOf<Any?>(null)
+    var coordinates: LayoutCoordinates? = null
+    var pointer by mutableStateOf<Offset?>(null)
+    fun hit(position: Offset): Any? {
+        val host = coordinates?.takeIf { it.isAttached } ?: return null
+        if (position.x !in 0f..host.size.width.toFloat() || position.y !in 0f..host.size.height.toFloat()) return null
+        val window = host.localToWindow(position)
+        return items.entries.firstOrNull { (_, item) ->
+            item.enabled && item.coordinates?.takeIf { it.isAttached }?.boundsInWindow()?.contains(window) == true
+        }?.key
+    }
+}
+
+internal fun Modifier.popupSlideSelection(
+    state: PopupSlideSelection?, scroll: ScrollState, haptic: HapticFeedback
+): Modifier = if (state == null) this else onGloballyPositioned { state.coordinates = it }
+    .pointerInput(state, scroll, haptic) {
+        coroutineScope {
+            // Retain access to overflow rows while holding near a viewport edge.
+            val edgeScroll = launch {
+                var lastFrame = 0L
+                while (true) {
+                    snapshotFlow { state.pointer }.first { it != null }
+                    lastFrame = 0L
+                    while (state.pointer != null) {
+                    withFrameNanos { now ->
+                        val dt = if (lastFrame == 0L) 0f else ((now - lastFrame) / 1_000_000_000f).coerceAtMost(0.04f)
+                        lastFrame = now
+                        val point = state.pointer
+                        if (point != null && scroll.maxValue > 0) {
+                            val edge = 28f * density
+                            val direction = when {
+                                point.y < edge -> -1f
+                                point.y > size.height - edge -> 1f
+                                else -> 0f
+                            }
+                            scroll.dispatchRawDelta(direction * 240f * density * dt)
+                            val next = state.hit(point)
+                            if (next != state.highlighted) {
+                                state.highlighted = next
+                                if (next != null) haptic.performHapticFeedback(HapticFeedbackType.TextHandleMove)
+                            }
+                        }
+                    }
+                    }
+                }
+            }
+            try {
+                awaitEachGesture {
+                    val down = awaitFirstDown(requireUnconsumed = false, pass = PointerEventPass.Initial)
+                    // Header/back controls are not selection rows. Leave their complete
+                    // gesture to the existing Miuix clickable instead of swallowing its UP.
+                    val initialItem = state.hit(down.position) ?: return@awaitEachGesture
+                    state.pointer = down.position
+                    state.highlighted = initialItem
+                    down.consume()
+                    try {
+                        while (true) {
+                            val event = awaitPointerEvent(PointerEventPass.Initial)
+                            val change = event.changes.firstOrNull { it.id == down.id } ?: break
+                            state.pointer = change.position
+                            val next = state.hit(change.position)
+                            if (next != state.highlighted) {
+                                state.highlighted = next
+                                if (next != null) haptic.performHapticFeedback(HapticFeedbackType.TextHandleMove)
+                            }
+                            val released = change.changedToUpIgnoreConsumed()
+                            change.consume()
+                            if (!change.pressed) {
+                                val action = if (released) next?.let { state.items[it] }?.takeIf { it.enabled }?.activate else null
+                                state.highlighted = null
+                                state.pointer = null
+                                action?.invoke()
+                                break
+                            }
+                        }
+                    } finally { state.highlighted = null; state.pointer = null }
+                }
+            } finally { edgeScroll.cancel() }
+        }
+    }
