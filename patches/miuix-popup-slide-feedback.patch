+private val PopupMorphRoom = 14.dp
+private val PopupMorphShadowPadding = 24.dp
+internal fun Density.popupMorphInsetPx(): Int =
+    PopupMorphRoom.roundToPx() + PopupMorphShadowPadding.roundToPx()
+
+/** Written by the host's measure/placement pass, before the first draw. */
+class PopupMorphAnchor {
+    var origin: TransformOrigin = TransformOrigin.Center
+    var size: IntSize = IntSize.Zero
+}
+
+private class PopupPanelOutline(private val rect: RoundRect) : Shape {
+    override fun createOutline(size: Size, layoutDirection: LayoutDirection, density: Density) =
+        Outline.Rounded(rect)
+}
+
+/** Material, expanded labels and the original value/arrow have independent animation layers. */
+@Composable
+internal fun MorphingListPopupContent(
+    modifier: Modifier,
+    fractionProgress: () -> Float,
+    originProgress: () -> Float,
+    isEntering: Boolean,
+    anchor: PopupMorphAnchor?,
+    fallbackOrigin: TransformOrigin,
+    onSizeChanged: (IntSize) -> Unit,
+    collapseContent: (@Composable () -> Unit)?,
+    content: @Composable () -> Unit,
+) {
+    val style = LocalListPopupVisualStyle.current
+    val density = LocalDensity.current
+    val corner = with(density) { style.cornerRadius.toPx() }
+    // Match the integer placement below exactly, including fractional device densities.
+    val room = with(density) { PopupMorphRoom.roundToPx().toFloat() }
+    val fallbackSize = with(density) { 28.dp.toPx() }
+    val extraWidth = with(density) { 14.dp.toPx() }
+    val extraHeight = with(density) { 10.dp.toPx() }
+    val background = style.backgroundColor ?: MiuixTheme.colorScheme.surfaceContainer
+    val blurSteps = remember(density) { arrayOfNulls<RenderEffect>(7) }
+    // Layout owns this value. All three layers use the same natural size in the same pass.
+    val naturalSize = remember { arrayOf(IntSize.Zero) }
+    val panel: () -> RoundRect = {
+        val natural = naturalSize[0]
+        val f = fractionProgress()
+        val origin = anchor?.origin ?: fallbackOrigin
+        val startWidth = (anchor?.size?.width?.takeIf { it > 0 }?.toFloat() ?: fallbackSize) + extraWidth
+        val startHeight = (anchor?.size?.height?.takeIf { it > 0 }?.toFloat() ?: fallbackSize) + extraHeight
+        val rawWidth = startWidth + (natural.width - startWidth) * f
+        val rawHeight = startHeight + (natural.height - startHeight) * f
+        val widthScale = if (natural.width > 0) rawWidth / natural.width else 1f
+        val migration = originProgress() * (1f - widthScale)
+        val canvasWidth = natural.width + 2f * room
+        val canvasHeight = natural.height + 2f * room
+        val width = rawWidth.coerceIn(0f, canvasWidth)
+        val height = rawHeight.coerceIn(0f, canvasHeight)
+        val x = (room + origin.pivotFractionX * (natural.width - rawWidth) +
+            (0.5f - origin.pivotFractionX) * natural.width * migration)
+            .coerceIn(0f, (canvasWidth - width).coerceAtLeast(0f))
+        val y = (room + origin.pivotFractionY * (natural.height - rawHeight) +
+            (0.5f - origin.pivotFractionY) * natural.height * migration)
+            .coerceIn(0f, (canvasHeight - height).coerceAtLeast(0f))
+        RoundRect(Rect(x, y, x + width, y + height), CornerRadius(min(corner, min(width, height) / 2f)))
+    }
+    Layout(
+        modifier = modifier.padding(PopupMorphShadowPadding).then(style.interactionModifier),
+        content = {
+            Box(Modifier
+                .graphicsLayer {
+                    // Only the material fades. At fraction=0 the trigger clone is still visible.
+                    alpha = (fractionProgress() * if (isEntering) 7f else 3.6f).coerceIn(0f, 1f)
+                    shape = PopupPanelOutline(panel())
+                    shadowElevation = 16.dp.toPx()
+                    ambientShadowColor = Color.Black.copy(alpha = 0.125f)
+                    spotShadowColor = ambientShadowColor
+                }
+                .drawWithCache {
+                    val clip = Path()
+                    val rim = Path()
+                    onDrawWithContent {
+                        val rect = panel()
+                        clip.reset()
+                        clip.addRoundRect(rect)
+                        clipPath(clip) { this@onDrawWithContent.drawContent() }
+                        style.border?.let { border ->
+                            val strokeWidth = border.width.toPx()
+                            val inset = strokeWidth / 2f
+                            val width = (rect.width - strokeWidth).coerceAtLeast(0f)
+                            val height = (rect.height - strokeWidth).coerceAtLeast(0f)
+                            val radius = (rect.topLeftCornerRadius.x - inset).coerceAtLeast(0f)
+                            rim.reset()
+                            rim.addRoundRect(RoundRect(0f, 0f, width, height, CornerRadius(radius)))
+                            translate(rect.left + inset, rect.top + inset) {
+                                val savedSize = drawContext.size
+                                drawContext.size = Size(width, height)
+                                try { drawPath(rim, border.brush, style = Stroke(strokeWidth)) }
+                                finally { drawContext.size = savedSize }
+                            }
+                        }
+                    }
+                }
+                .then(style.surfaceModifier)
+                .background(background)
+            )
