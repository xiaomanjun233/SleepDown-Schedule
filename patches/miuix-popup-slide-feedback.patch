+                val rect = panel()
+                alpha = (1f - fractionProgress() * if (isEntering) 3.2f else 1.7f).coerceIn(0f, 1f)
+                translationX = (rect.left + rect.right - size.width) / 2f
+                translationY = (rect.top + rect.bottom - size.height) / 2f
+            }) { collapseContent?.invoke() }
+        },
+    ) { measurables, constraints ->
+        val roomPx = room.toInt()
+        val labels = measurables[1].measure(constraints.offset(-roomPx * 2, -roomPx * 2))
+        naturalSize[0] = IntSize(labels.width, labels.height)
+        val canvasWidth = labels.width + roomPx * 2
+        val canvasHeight = labels.height + roomPx * 2
+        val material = measurables[0].measure(Constraints.fixed(canvasWidth, canvasHeight))
+        val trigger = measurables[2].measure(Constraints(
+            maxWidth = (anchor?.size?.width?.takeIf { it > 0 } ?: labels.width).coerceAtLeast(0),
+            maxHeight = constraints.maxHeight,
+        ))
+        layout(canvasWidth, canvasHeight) {
+            material.place(0, 0)
+            labels.place(roomPx, roomPx)
+            trigger.place(0, 0)
+        }
+    }
+}
