+        var coordinates: LayoutCoordinates? = null
+    }
+    val items = linkedMapOf<Any, Item>()
+    var highlighted by mutableStateOf<Any?>(null)
+    var coordinates: LayoutCoordinates? = null
+    var pointer by mutableStateOf<Offset?>(null)
+    fun hit(position: Offset): Any? {
+        val host = coordinates?.takeIf { it.isAttached } ?: return null
+        if (position.x !in 0f..host.size.width.toFloat() || position.y !in 0f..host.size.height.toFloat()) return null
+        val window = host.localToWindow(position)
+        return items.entries.firstOrNull { (_, item) ->
+            item.enabled && item.coordinates?.takeIf { it.isAttached }?.boundsInWindow()?.contains(window) == true
+        }?.key
+    }
+}
