+
+package top.yukonga.miuix.kmp.basic
+
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Box
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawWithCache
+import androidx.compose.ui.geometry.CornerRadius
+import androidx.compose.ui.geometry.Rect
+import androidx.compose.ui.geometry.RoundRect
+import androidx.compose.ui.geometry.Size
+import androidx.compose.ui.graphics.BlurEffect
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.Outline
+import androidx.compose.ui.graphics.Path
+import androidx.compose.ui.graphics.RenderEffect
+import androidx.compose.ui.graphics.Shape
+import androidx.compose.ui.graphics.TileMode
+import androidx.compose.ui.graphics.TransformOrigin
+import androidx.compose.ui.graphics.drawscope.Stroke
+import androidx.compose.ui.graphics.drawscope.clipPath
+import androidx.compose.ui.graphics.drawscope.translate
+import androidx.compose.ui.graphics.graphicsLayer
+import androidx.compose.ui.layout.onSizeChanged
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.Density
+import androidx.compose.ui.unit.IntSize
+import androidx.compose.ui.unit.LayoutDirection
+import androidx.compose.ui.unit.dp
+import top.yukonga.miuix.kmp.theme.MiuixTheme
+import kotlin.math.abs
+import kotlin.math.min
+import kotlin.math.roundToInt
+
+/** Written by the host's placement pass, before the first draw (no one-frame state lag). */
+class PopupMorphAnchor {
+    var origin: TransformOrigin = TransformOrigin.Center
+    var size: IntSize = IntSize.Zero
+}
+
+private class PopupPanelOutline(private val rect: RoundRect) : Shape {
+    override fun createOutline(size: Size, layoutDirection: LayoutDirection, density: Density) =
+        Outline.Rounded(rect)
+}
+
+/** A fixed sampling canvas with a moving panel outline and a separate, uniformly scaled label layer. */
+@Composable
+internal fun MorphingListPopupContent(
+    modifier: Modifier,
+    fractionProgress: () -> Float,
+    originProgress: () -> Float,
+    isEntering: Boolean,
+    anchor: PopupMorphAnchor?,
+    fallbackOrigin: TransformOrigin,
+    onSizeChanged: (IntSize) -> Unit,
+    content: @Composable () -> Unit,
+) {
+    val style = LocalListPopupVisualStyle.current
+    val density = LocalDensity.current
+    val corner = with(density) { style.cornerRadius.toPx() }
+    val fallbackSize = with(density) { 28.dp.toPx() }
+    val background = style.backgroundColor ?: MiuixTheme.colorScheme.surfaceContainer
+    val blurSteps = remember(density) { arrayOfNulls<RenderEffect>(7) }
+    val panel: (Size) -> RoundRect = { size ->
+        val f = fractionProgress().coerceIn(0f, 1f)
+        val origin = anchor?.origin ?: fallbackOrigin
+        val startWidth = (anchor?.size?.width?.takeIf { it > 0 }?.toFloat() ?: fallbackSize)
+            .coerceAtMost(size.width)
+        val startHeight = (anchor?.size?.height?.takeIf { it > 0 }?.toFloat() ?: fallbackSize)
+            .coerceAtMost(size.height)
+        val width = startWidth + (size.width - startWidth) * f
+        val height = startHeight + (size.height - startHeight) * f
+        val widthScale = if (size.width > 0f) width / size.width else 1f
+        val migration = originProgress() * (1f - widthScale)
+        val x = (origin.pivotFractionX * (size.width - width) +
+            (0.5f - origin.pivotFractionX) * size.width * migration)
+            .coerceIn(0f, (size.width - width).coerceAtLeast(0f))
+        val y = (origin.pivotFractionY * (size.height - height) +
+            (0.5f - origin.pivotFractionY) * size.height * migration)
+            .coerceIn(0f, (size.height - height).coerceAtLeast(0f))
+        RoundRect(Rect(x, y, x + width, y + height), CornerRadius(min(corner, min(width, height) / 2f)))
+    }
+    Box(
+        modifier = modifier
+            .then(style.interactionModifier)
+            .onSizeChanged(onSizeChanged)
+            .graphicsLayer {
+                alpha = (fractionProgress() * if (isEntering) 7f else 3.6f).coerceIn(0f, 1f)
+                // Give the whole settled panel the spring overshoot, without revealing empty
+                // pixels outside the material canvas or allocating a larger sampling buffer.
+                scaleX = fractionProgress().coerceAtLeast(1f)
+                scaleY = scaleX
+                shape = PopupPanelOutline(panel(size))
+                shadowElevation = 16.dp.toPx()
+                ambientShadowColor = Color.Black.copy(alpha = 0.125f)
+                spotShadowColor = ambientShadowColor
+            }
+            .drawWithCache {
+                val clip = Path()
+                val rim = Path()
+                onDrawWithContent {
+                    val rect = panel(size)
+                    clip.reset()
+                    clip.addRoundRect(rect)
+                    clipPath(clip) { this@onDrawWithContent.drawContent() }
+                    style.border?.let { border ->
+                        val strokeWidth = border.width.toPx()
+                        val inset = strokeWidth / 2f
+                        val width = (rect.width - strokeWidth).coerceAtLeast(0f)
+                        val height = (rect.height - strokeWidth).coerceAtLeast(0f)
+                        val radius = (rect.topLeftCornerRadius.x - inset).coerceAtLeast(0f)
+                        rim.reset()
+                        rim.addRoundRect(RoundRect(0f, 0f, width, height, CornerRadius(radius)))
+                        translate(rect.left + inset, rect.top + inset) {
+                            // Size the gradient to the actual panel, including the small opening frame.
+                            val savedSize = drawContext.size
+                            drawContext.size = Size(width, height)
+                            try { drawPath(rim, border.brush, style = Stroke(strokeWidth)) }
+                            finally { drawContext.size = savedSize }
+                        }
+                    }
+                }
+            },
+    ) {
+        // The canvas does not scale with the text, so sampled pixels never drift or stretch
+        // while the silhouette grows. Kyant press/drag feedback remains on the common parent.
+        Box(Modifier.matchParentSize().then(style.surfaceModifier).background(background))
+        Box(Modifier.graphicsLayer {
+            val rect = panel(size)
+            val f = fractionProgress()
+            val from = if (isEntering) 0.22f else 0.30f
+            val to = if (isEntering) 0.62f else 0.78f
+            alpha = ((f - from) / (to - from)).coerceIn(0f, 1f)
+            scaleX = if (size.width > 0f) rect.width / size.width else 1f
+            scaleY = scaleX
+            translationX = (rect.left + rect.right - size.width) / 2f
+            translationY = (rect.top + rect.bottom - size.height) / 2f
+            val step = (6f * (1f - abs(2f * f - 1f)).coerceIn(0f, 1f)).roundToInt()
+            renderEffect = if (step == 0) null else blurSteps[step] ?: run {
+                val radius = step.dp.toPx()
+                BlurEffect(radius, radius, TileMode.Decal).also { blurSteps[step] = it }
+            }
+        }) { content() }
+    }
+}
