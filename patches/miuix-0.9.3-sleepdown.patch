+@Composable
+private fun rememberPopupTriggerTransferred(show: Boolean, morph: Boolean): MutableState<Boolean> {
+    val transferred = remember { mutableStateOf(false) }
+    LaunchedEffect(show, morph) {
+        if (!morph) transferred.value = false
+        else if (show) {
+            // Give the overlay time to measure the anchor before it owns these glyphs.
+            repeat(2) { withFrameNanos {} }
+            transferred.value = true
+        }
+    }
+    return transferred
+}
+
+@Composable
+private fun PopupTriggerContent(text: String?, actionColor: Color, modifier: Modifier = Modifier) {
+    Row(modifier = modifier, verticalAlignment = Alignment.CenterVertically) {
+        if (!text.isNullOrEmpty()) {
+            Text(
+                text = text,
+                modifier = Modifier.padding(end = 8.dp).weight(1f, fill = false),
+                fontSize = MiuixTheme.textStyles.body2.fontSize,
+                color = actionColor,
+                textAlign = TextAlign.End,
+            )
+        }
+        DropdownArrowEndAction(actionColor = actionColor)
+    }
+}
+
+@Composable
+private fun rememberPopupAnchorContentAlpha(fractionState: State<Float>): Float {
+    val contentAlpha = remember { Animatable(1f) }
+    LaunchedEffect(Unit) {
+        var previousFraction = fractionState.value
+        var contentVisible = true
+        var animationJob: Job? = null
+        snapshotFlow { fractionState.value }.collect { current ->
+            val entering = current >= previousFraction
+            previousFraction = current
+            val newVisible = if (entering) current < 0.15f else current < 0.20f
+            if (newVisible != contentVisible) {
+                contentVisible = newVisible
+                animationJob?.cancel()
+                animationJob = launch {
+                    contentAlpha.animateTo(
+                        targetValue = if (newVisible) 1f else 0f,
+                        animationSpec = tween(180),
+                    )
+                }
+            }
+        }
+    }
+    return contentAlpha.value
+}
 
